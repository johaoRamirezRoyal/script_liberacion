# Copiar a .env y completar. Nunca subir el .env a git.

# Base de datos del servidor (la misma del backend)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sami_royal
DB_USERNAME=
DB_PASSWORD=

# Cloudinary (las mismas credenciales del backend)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Backend: URL base (sin /api) y el mismo MIGRACION_API_TOKEN del .env del backend
API_URL=http://localhost:8000
MIGRACION_API_TOKEN=

# Carpeta física de uploads (SAMI_UPLOAD_ROOT del backend)
UPLOAD_ROOT=/home/royal/sami_royal/public/upload
